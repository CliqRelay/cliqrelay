# Example environment variables for the API service. Copy this file to .env and fill in the values.
# Some of these ENV vars come from the Authula library as denoted by comments so follow the docs there: https://www.authula.dev/docs

# Authula

REDIS_URL=
EVENT_BUS_CONSUMER_GROUP=cliqrelay-consumer-group

EMAIL_PROVIDER=smtp
FROM_ADDRESS=noreply@example.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

AUTHULA_BASE_URL=
AUTHULA_SECRET=

# CliqRelay

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PRESIGNED_URL_EXPIRY=15m
S3_MANAGE_BUCKET_CORS=true

# OpenAPI spec version (defaults to "0.1.0" if not set)
OPENAPI_SPEC_VERSION=0.1.0
CLIENT_URL=
# The side panel's own origin, e.g. chrome-extension://<extension id>. Authula's
# CORS and CSRF origin checks are built from CLIENT_URL and this, so `GET /me`
# from the extension fails without it.
EXTENSION_URL=
DATABASE_URL=
STANDALONE_MODE=true
BASE_URL=http://localhost:8080
PORT=8080
GO_ENV=development
LOG_LEVEL=debug
